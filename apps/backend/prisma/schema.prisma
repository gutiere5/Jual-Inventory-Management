generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  PURCHASE
  SALE
  RETURN
  WASTE
  ADJUSTMENT
}

enum WasteReason {
  EXPIRED
  DAMAGED
  THEFT
  MISTAKE
  OTHER
}

enum UnitOfMeasure {
  EA
  LB
  OZ
  KG
  G
  L
  ML
}

enum Category {
  PRODUCE
  DAIRY
  BEVERAGES
  MEAT
  FRUIT
  SEAFOOD
  BAKERY
  DRY_GOODS
  CANNED_GOODS
  FROZEN
  SPICES
  HOUSEHOLD
  PREPARED
  BEEF
  POULTRY
  PORK
  RESTAURANT
  OTHER
}

enum MeatChoice {
  CARNE_ASADA
  CHORIZO
  TRIPA
  LENGUA
  PASTOR
  CHICHARRONES
  ASADA_DE_POLLO
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  username   String   @unique
  password   String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Item {
  id                Int            @id @default(autoincrement())
  sku               String?        @unique @db.VarChar(100)
  name              String?        @db.VarChar(255)
  description       String?        @db.VarChar(255)
  ingredients       String?        @db.VarChar(255)
  uom               UnitOfMeasure?
  price             Decimal?       @db.Money
  vendorId          Int?
  lowStockThreshold Int?           @default(10)
  imageUrl          String?        @db.VarChar(255)
  meatChoices       MeatChoice[]
  category          Category
  vendor            Vendor?        @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stockBatch        StockBatch[]
  transaction       Transaction[]
  waste             Waste[]
  menuItems         MenuItem[]
}

model StockBatch {
  id                Int           @id @default(autoincrement())
  itemId            Int?
  quantityReceived  Decimal       @db.Decimal(12, 3)
  quantityRemaining Decimal       @db.Decimal(12, 3)
  expirationDate    DateTime?     @db.Date
  receivedAt        DateTime?     @default(now()) @db.Timestamp(6)
  costAtPurchase    Decimal?      @db.Decimal(12, 2)
  item              Item?         @relation(fields: [itemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction       Transaction[]
  waste             Waste[]
}

model Transaction {
  id              Int             @id @default(autoincrement())
  itemId          Int?
  batchId         Int?
  type            TransactionType
  quantity        Decimal?        @db.Decimal(12, 3)
  transactionDate DateTime?       @default(now()) @db.Timestamp(6)
  stockBatch      StockBatch?     @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  item            Item?           @relation(fields: [itemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Vendor {
  id   Int     @id @default(autoincrement())
  name String? @db.VarChar(255)
  item Item[]
}

model Waste {
  id         Int         @id @default(autoincrement())
  itemId     Int?
  batchId    Int?
  quantity   Decimal     @db.Decimal(12, 3)
  reason     WasteReason
  createdAt  DateTime    @default(now()) @db.Timestamp(6)
  stockBatch StockBatch? @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  item       Item?       @relation(fields: [itemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Canvas {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  lines     Line[]
  rectangle Rectangle[]
  text      Text[]
  circle    Circle[]
  menuItem  MenuItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Line {
  id          Int     @id @default(autoincrement())
  type        String
  canvasId    Int
  canvas      Canvas  @relation(fields: [canvasId], references: [id])
  x           Float
  y           Float
  scaleX      Float
  scaleY      Float
  points      Float[]
  stroke      String
  strokeWidth Float
  label       String
}

model Rectangle {
  id           Int       @id @default(autoincrement())
  type         String
  canvasId     Int
  canvas       Canvas    @relation(fields: [canvasId], references: [id])
  x            Float
  y            Float
  scaleX       Float
  scaleY       Float
  width        Decimal
  height       Decimal
  fill         String
  stroke       String
  strokeWidth  Decimal
  cornerRadius Decimal
  dash         Decimal[]
  dashEnabled  Boolean
  label        String
}

model Text {
  id         Int     @id @default(autoincrement())
  canvasId   Int
  canvas     Canvas  @relation(fields: [canvasId], references: [id])
  fontSize   Decimal
  fill       String
  fontFamily String
  fontStyle  String
}

model Circle {
  id          Int     @id @default(autoincrement())
  type        String
  canvasId    Int
  canvas      Canvas  @relation(fields: [canvasId], references: [id])
  x           Float
  y           Float
  scaleX      Float
  scaleY      Float
  radius      Decimal
  fill        String
  stroke      String
  strokeWidth Decimal
  label       String
}

model MenuItem {
  id               Int     @id @default(autoincrement())
  type             String
  canvasId         Int
  canvas           Canvas  @relation(fields: [canvasId], references: [id])
  x                Float
  y                Float
  scaleX           Float
  scaleY           Float
  showTitle        Boolean
  showImage        Boolean
  showDescription  Boolean
  showPrice        Boolean
  titleStyle       String
  descriptionStyle String
  priceStyle       String
  itemId           Int
  item             Item    @relation(fields: [itemId], references: [id])
}
